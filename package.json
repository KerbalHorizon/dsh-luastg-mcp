{
  "name": "dsh-luastg-mcp",
  "version": "1.1.0",
  "description": "DSH plugin bridging to the LuaSTG Editor Sharp X MCP bridge over TCP: live node-tree reads, path-based attribute and Code-script updates, node insertion and subtree deletion through real editor commands",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "scripts/capture-window.ps1",
    "csharp",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "luastg",
    "luastg-sharp-x",
    "mcp",
    "tcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node --import ./test/setup.mjs scripts/check.mjs",
    "test": "node scripts/build.mjs && node --import ./test/setup.mjs test/all.mjs",
    "prepack": "node scripts/build.mjs"
  }
}
